# ROS 2 build and runtime outputs
/build/
/install/
/log/

# Large recorded datasets
/bags/

# Generated evaluation outputs
/evaluation/

# Python caches and local generated files
__pycache__/
*.py[cod]

# Local SSH private key accidentally stored at the workspace root
/ssh -T git@github.com

# Keep nested package repositories from being treated as separate Git roots.
# Their source files are tracked by this workspace repository.